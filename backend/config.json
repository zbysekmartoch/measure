{
  "paths": {
    "scripts": "scripts",
    "results": "results"
  },
  "scriptCommands": {
    ".py": {
      "command": "./labs/.venv/bin/python",
      "description": "Python scripts"
    },
    ".js": {
      "command": "node", 
      "description": "Node.js scripts"
    },
    ".cjs": {
      "command": "node", 
      "description": "Node.js scripts"
    },
    ".sh": {
      "command": "bash", 
      "description": "Shell scripts"
    },
    ".r": {
      "command": "Rscript",
      "description": "R scripts"
    },
    ".R": {
      "command": "Rscript",
      "description": "R scripts"
    }
  },
  "logging": {
    "logFileName": "analysis.log",
    "errorFileName": "analysis.err",
    "timestampFormat": "ISO",
    "separatorChar": "=",
    "separatorLength": 80
  },
  "analysis": {
    "defaultTimeout": 300000,
    "maxConcurrentAnalyses": 5
  },
  "resources": {
    "_comment": "Memory guard for workflow scripts. Absolute Mb values win over percents; 0 = derive from percent of total RAM.",
    "maxMemoryMb": 0,
    "maxMemoryPercent": 90,
    "minAvailableMb": 0,
    "minAvailablePercent": 20,
    "waitPollMs": 5000,
    "maxWaitMs": 1800000,
    "sampleIntervalMs": 2000,
    "useCgroup": true
  },
  "requestLimits": {
    "jsonBodyLimit": "1mb",
    "auth": {
      "windowMs": 60000,
      "maxPerIp": 40
    },
    "api": {
      "windowMs": 60000,
      "maxPerKey": 1200
    }
  },
  "fileManager": {
    "defaultDepth": 0,
    "hiddenFilePrefixes": [".","_","node_modules"]
  },
  "keyboardMenu": {
    "activationKey": "Escape",
    "activationMaxDelayMs": 500,
    "actions": {
      "toggleView": "V",
      "saveAll": "S",
      "unlockAll": "U",
      "openScripts": "C",
      "openDebug": "D",
      "openChat": "X",
      "runSelected": "R"
    }
  },
  "outputsFolderName": "Outputs",
  "csvPreviewMaxRows": 100,
  "previewMaxFileSize": 1048576,
  "office": {
    "enabled": true,
    "documentServerUrl": "http://localhost:8080",
    "jwtSecret": "2efgYW6MAKphEXqE2BUQHQjIMHcS4t8p",
    "appUrl": "http://localhost:50100",
    "forceSaveIntervalMs": 30000,
    "forceSaveWaitTimeoutMs": 12000,
    "sessionPreregistrationTtlMs": 120000,
    "accessTokenTtl": "2h",
    "configTokenTtl": "1h"
  }
