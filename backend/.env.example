NODE_ENV=development
PORT=50100

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=rpa_db

# JWT Secret - change in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Povolený původ(y) pro CORS – oddělit čárkou
CORS_ORIGINS=http://localhost:50101,http://localhost:50100

# Email konfigurace pro reset hesla
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@rpa-backend.com

# Frontend URL pro reset linky
FRONTEND_URL=http://localhost:50101

# Euro/OnlyOffice integration (DOCX/XLSX)
OFFICE_ENABLED=true
DOC_SERVER_URL=http://localhost:8080
DOC_SERVER_JWT_SECRET=replace-with-document-server-jwt-secret
OFFICE_APP_URL=http://localhost:50100
OFFICE_TOKEN_SECRET=replace-with-random-office-token-secret
OFFICE_ACCESS_TOKEN_TTL=2h
OFFICE_CONFIG_TOKEN_TTL=1h
OFFICE_FORCE_SAVE_INTERVAL_MS=30000
OFFICE_FORCE_SAVE_WAIT_TIMEOUT_MS=12000
OFFICE_SESSION_PREREGISTRATION_TTL_MS=120000
